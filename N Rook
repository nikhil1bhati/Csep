#include <iostream>
using namespace std;

int n;
int board[20][20];

bool safe(int row, int col)
{
    for(int i = 0; i < row; i++)
    {
        if(board[i][col] == 1)
            return false;
    }

    return true;
}

void printBoard()
{
    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < n; j++)
        {
            if(board[i][j] == 1)
                cout << "R ";
            else
                cout << ". ";
        }
        cout << endl;
    }
    cout << endl;
}

void solve(int row)
{
    if(row == n)
    {
        printBoard();
        return;
    }

    for(int col = 0; col < n; col++)
    {
        if(safe(row, col))
        {
            board[row][col] = 1;
            solve(row + 1);
            board[row][col] = 0;
        }
    }
}

int main()
{
    cin >> n;

    solve(0);

    return 0;
}
